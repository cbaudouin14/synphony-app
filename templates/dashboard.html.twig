{% extends 'base.html.twig' %}

{% block title %}Tableau de bord
{% endblock %}

{% block body %}

<div class="container">

    <div class="mb-5">
        <h1 class="fw-bold">Tableau de bord</h1>
        <p class="text-muted">
            Bienvenue <strong>{{ app.user.userIdentifier }}</strong> 👋
        </p>
    </div>

    <div class="row g-4">

        <div class="col-md-4">
            <div class="card card-shadow h-100">
                <div class="card-body text-center">

                    <h5 class="card-title mb-3">
                        📚 Catalogue
                    </h5>

                    <p class="text-muted">
                        Consulter tous les livres disponibles dans la bibliothèque.
                    </p>

                    <a href="{{ path('app_book_index') }}" class="btn btn-primary">
                        Voir les livres
                    </a>

                </div>
            </div>
        </div>


        <div class="col-md-4">
            <div class="card card-shadow h-100">
                <div class="card-body text-center">

                    <h5 class="card-title mb-3">
                        📖 Réservations
                    </h5>

                    <p class="text-muted">
                        Consultez et gérez vos réservations de livres.
                    </p>

                    <a href="{{ path('app_reservation_index') }}" class="btn btn-primary">
                        Mes réservations
                    </a>

                </div>
            </div>
        </div>


        {% if is_granted('ROLE_ADMIN') %}
        <div class="col-md-4">
            <div class="card card-shadow h-100">
                <div class="card-body text-center">

                    <h5 class="card-title mb-3">
                        👥 Administration
                    </h5>

                    <p class="text-muted">
                        Gérer les utilisateurs de la plateforme.
                    </p>

                    <a href="{{ path('app_user_index') }}" class="btn btn-primary">
                        Gérer les utilisateurs
                    </a>

                </div>
            </div>
        </div>
        {% endif %}

    </div>


    <div class="text-center mt-5">
        <a href="{{ logout_path() }}" class="btn btn-outline-danger">
            Se déconnecter
        </a>
    </div>

</div>

{% endblock %}
