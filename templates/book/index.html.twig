{% extends 'base.html.twig' %}

{% block title %}Catalogue des livres
{% endblock %}

{% block body %}
<div class="container py-5">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="fw-bold text-dark">📚 Catalogue des livres</h1>

        {% if is_granted('ROLE_ADMIN') %}
            <a class="btn btn-primary shadow-sm" href="{{ path('app_book_new') }}">
                + Ajouter un livre
            </a>
        {% endif %}
    </div>

    <div class="card border-0 shadow-lg rounded-4">
        <div class="card-body p-4">

            <div class="table-responsive">

                <table class="table table-hover align-middle">

                    <thead class="border-bottom">
                        <tr class="text-muted text-uppercase small">
                            <th>Titre</th>
                            <th>Auteur</th>
                            <th>Stock</th>
                            <th>Disponible</th>
                            <th class="text-end">Actions</th>
                        </tr>
                    </thead>

                    <tbody>

                    {% for book in books %}
                        <tr>

                            <td class="fw-semibold text-dark">
                                {{ book.title }}
                            </td>

                            <td class="text-muted">
                                {{ book.author }}
                            </td>

                            <td>
                                <span class="badge bg-light text-dark border">
                                    {{ book.stock }}
                                </span>
                            </td>

                            <td>
                                {% if book.available %}
                                    <span class="badge rounded-pill bg-success-subtle text-success">
                                        Disponible
                                    </span>
                                {% else %}
                                    <span class="badge rounded-pill bg-danger-subtle text-danger">
                                        Indisponible
                                    </span>
                                {% endif %}
                            </td>

                            <td class="text-end">

                                <a class="btn btn-outline-primary btn-sm"
                                   href="{{ path('app_book_show', {'id': book.id}) }}">
                                   Voir
                                </a>

                                {% if is_granted('ROLE_ADMIN') %}
                                    <a class="btn btn-outline-warning btn-sm"
                                       href="{{ path('app_book_edit', {'id': book.id}) }}">
                                       Modifier
                                    </a>
                                {% endif %}

                            </td>

                        </tr>

                    {% else %}
                        <tr>
                            <td colspan="5" class="text-center text-muted py-4">
                                Aucun livre trouvé
                            </td>
                        </tr>
                    {% endfor %}

                    </tbody>

                </table>

            </div>

        </div>
    </div>

</div>
{% endblock %}
