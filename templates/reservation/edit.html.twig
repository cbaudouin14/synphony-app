{% extends 'base.html.twig' %}

{% block title %}Modifier réservation{% endblock %}

{% block body %}
<div class="container py-5">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="fw-bold">✏️ Modifier la réservation</h1>

        <a class="btn btn-outline-secondary" href="{{ path('app_reservation_index') }}">
            ← Retour aux réservations
        </a>
    </div>

    <div class="card border-0 shadow-lg rounded-4 mb-4">
        <div class="card-body p-4">

            {{ include('reservation/_form.html.twig', {'button_label': 'Enregistrer les modifications'}) }}

        </div>
    </div>

    <div class="d-flex gap-2">
        {{ include('reservation/_delete_form.html.twig') }}
    </div>

</div>
{% endblock %}