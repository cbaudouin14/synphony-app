{% extends 'base.html.twig' %}

{% block title %}Réservation {{ reservation.id }}{% endblock %}

{% block body %}
<div class="container py-5">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="fw-bold">📅 Réservation n°{{ reservation.id }}</h1>

        <a class="btn btn-outline-secondary" href="{{ path('app_reservation_index') }}">
            ← Retour aux réservations
        </a>
    </div>

    <div class="card border-0 shadow-lg rounded-4 mb-4">
        <div class="card-body p-4">

            <table class="table align-middle mb-0">

                <tbody>

                    <tr>
                        <th class="text-muted">ID</th>
                        <td>{{ reservation.id }}</td>
                    </tr>

                    <tr>
                        <th class="text-muted">Livre</th>
                        <td>
                            {% for book in reservation.book %}
                                <span class="badge bg-light text-dark border">
                                    {{ book.title }}
                                </span>
                            {% else %}
                                <span class="text-muted">Aucun livre</span>
                            {% endfor %}
                        </td>
                    </tr>

                    <tr>
                        <th class="text-muted">Date début</th>
                        <td>{{ reservation.startDate ? reservation.startDate|date('d/m/Y') : '' }}</td>
                    </tr>

                    <tr>
                        <th class="text-muted">Date fin prévue</th>
                        <td>{{ reservation.expectedEndDate ? reservation.expectedEndDate|date('d/m/Y') : '' }}</td>
                    </tr>

                    <tr>
                        <th class="text-muted">Statut</th>
                        <td>
                            {% if reservation.active %}
                                <span class="badge rounded-pill bg-success-subtle text-success">
                                    Active
                                </span>
                            {% else %}
                                <span class="badge rounded-pill bg-secondary-subtle text-secondary">
                                    Terminée
                                </span>
                            {% endif %}
                        </td>
                    </tr>

                </tbody>

            </table>

        </div>
    </div>

    {% if is_granted('ROLE_ADMIN') %}
        <div class="d-flex gap-2">

            <a class="btn btn-outline-warning"
               href="{{ path('app_reservation_edit', {'id': reservation.id}) }}">
               Modifier
            </a>

            {{ include('reservation/_delete_form.html.twig') }}

        </div>
    {% endif %}

</div>
{% endblock %}