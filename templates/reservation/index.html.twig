{% extends 'base.html.twig' %}

{% block title %}Réservations{% endblock %}

{% block body %}
<div class="container py-5">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="fw-bold">📅 Liste des réservations</h1>

        {% if is_granted('ROLE_ADMIN') %}
            <a class="btn btn-primary shadow-sm" href="{{ path('app_reservation_new') }}">
                + Ajouter une réservation
            </a>
        {% endif %}
    </div>

    <div class="card border-0 shadow-lg rounded-4">
        <div class="card-body p-4">

            <div class="table-responsive">
                <table class="table table-hover align-middle">

                    <thead class="border-bottom">
                        <tr class="text-muted text-uppercase small">
                            <th>ID</th>
                            <th>Livre</th>
                            <th>Date début</th>
                            <th>Date fin prévue</th>
                            <th>Active</th>
                            <th class="text-end">Actions</th>
                        </tr>
                    </thead>

                    <tbody>

                    {% for reservation in reservations %}
                        <tr>

                            <td class="fw-semibold">{{ reservation.id }}</td>

                            <td>
                                {% for book in reservation.book %}
                                    <span class="badge bg-light text-dark border">
                                        {{ book.title }}
                                    </span>
                                {% else %}
                                    <span class="text-muted">Aucun livre</span>
                                {% endfor %}
                            </td>

                            <td>{{ reservation.startDate ? reservation.startDate|date('d/m/Y') : '' }}</td>

                            <td>{{ reservation.expectedEndDate ? reservation.expectedEndDate|date('d/m/Y') : '' }}</td>

                            <td>
                                {% if reservation.active %}
                                    <span class="badge rounded-pill bg-success-subtle text-success">
                                        Active
                                    </span>
                                {% else %}
                                    <span class="badge rounded-pill bg-secondary-subtle text-secondary">
                                        Terminée
                                    </span>
                                {% endif %}
                            </td>

                            <td class="text-end">

                                <a class="btn btn-outline-primary btn-sm"
                                   href="{{ path('app_reservation_show', {'id': reservation.id}) }}">
                                   Voir
                                </a>

                                {% if is_granted('ROLE_ADMIN') %}
                                    <a class="btn btn-outline-warning btn-sm"
                                       href="{{ path('app_reservation_edit', {'id': reservation.id}) }}">
                                       Modifier
                                    </a>
                                {% endif %}

                            </td>

                        </tr>

                    {% else %}

                        <tr>
                            <td colspan="6" class="text-center text-muted py-4">
                                Aucune réservation trouvée
                            </td>
                        </tr>

                    {% endfor %}

                    </tbody>

                </table>
            </div>

        </div>
    </div>

</div>
{% endblock %}