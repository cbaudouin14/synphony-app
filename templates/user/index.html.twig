{% extends 'base.html.twig' %}

{% block title %}Utilisateurs{% endblock %}

{% block body %}
<div class="container py-5">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="fw-bold">👤 Gestion des utilisateurs</h1>

        <a class="btn btn-primary shadow-sm" href="{{ path('app_user_new') }}">
            + Créer un utilisateur
        </a>
    </div>

    <div class="card border-0 shadow-lg rounded-4">
        <div class="card-body p-4">

            <div class="table-responsive">
                <table class="table table-hover align-middle">

                    <thead class="border-bottom">
                        <tr class="text-muted text-uppercase small">
                            <th>ID</th>
                            <th>Email</th>
                            <th>Rôles</th>
                            <th class="text-end">Actions</th>
                        </tr>
                    </thead>

                    <tbody>

                    {% for user in users %}
                        <tr>

                            <td class="fw-semibold">{{ user.id }}</td>

                            <td>{{ user.email }}</td>

                            <td>
                                {% for role in user.roles %}
                                    {% if role == 'ROLE_ADMIN' %}
                                        <span class="badge bg-danger-subtle text-danger">
                                            Admin
                                        </span>
                                    {% elseif role == 'ROLE_USER' %}
                                        <span class="badge bg-primary-subtle text-primary">
                                            Utilisateur
                                        </span>
                                    {% else %}
                                        <span class="badge bg-light text-dark border">
                                            {{ role }}
                                        </span>
                                    {% endif %}
                                {% endfor %}
                            </td>

                            <td class="text-end">

                                <a class="btn btn-outline-primary btn-sm"
                                   href="{{ path('app_user_show', {'id': user.id}) }}">
                                   Voir
                                </a>

                                <a class="btn btn-outline-warning btn-sm"
                                   href="{{ path('app_user_edit', {'id': user.id}) }}">
                                   Modifier
                                </a>

                                <a class="btn btn-outline-info btn-sm"
                                   href="{{ path('app_user_reservations', {'id': user.id}) }}">
                                   Réservations
                                </a>

                            </td>

                        </tr>

                    {% else %}

                        <tr>
                            <td colspan="4" class="text-center text-muted py-4">
                                Aucun utilisateur trouvé
                            </td>
                        </tr>

                    {% endfor %}

                    </tbody>

                </table>
            </div>

        </div>
    </div>

</div>
{% endblock %}